---
import NavbarSiteLayout from "../layouts/NavbarSiteLayout.astro";
import { quickLinks } from "../data/constants";
import Icon from "../components/icon.astro";
import {check} from "../data/standard-icons";
---

<NavbarSiteLayout
  title="Thanks"
  description="Thank you for filling out the contact form."
  noindex
>
  <div class="content-chapter secondary-scheme">
    <div class="content-container">
      <div class="thank-you">
        <h2 class="ty-heading">
          Thank You <Icon src={check} class="ty-checkmark" />
        </h2>
        <p>
          Your message has been sent. You can expect an email reply within 24 hours.
        </p>
        <hr />
        <nav class="navigation" aria-label="Footer Navigation">
          {
            quickLinks.map(link => (
              <a href={link.href} class="quick-link tail-fade">
                <div class="tail-fade" />
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</NavbarSiteLayout>

<style>
  .content-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 80vh;
  }

  .thank-you {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    max-width: var(--half-width);
  }

  .ty-heading {
    text-align: center;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ty-checkmark {
    width: 48px;
    fill: var(--accent-1-color);
  }

  .thank-you p {
    max-width: 490px;
    text-align: center;
  }

  .navigation {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px;
  }

  .navigation a {
    font-family: var(--font-accent);
    color: var(--dark-heading);
    text-decoration: none;
    font-size: 0.875rem;

    &:hover {
      text-decoration: underline;
    }
  }
</style>