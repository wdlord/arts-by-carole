---
import NavbarSiteLayout from "../layouts/NavbarSiteLayout.astro";
import Hero from "../sections/Hero.astro";
import PortraitQuote from "../sections/PortraitQuote.astro";
import Contact from "../sections/Contact.astro";
import Explore from "../sections/Explore.astro";
---

<NavbarSiteLayout
	title=`Local North County Arts and Historical Memorabilia`
	description="Carole Nylander captures more than what the eye sees, celebrating the beauty of our world while exploring the emotions, stories, and human experiences within it."
>
	<Hero />
  <PortraitQuote />
  <Explore />
	<Contact />
  
</NavbarSiteLayout>

<style>
	.map-embed-container {
    border-right: var(--border);
    height: 300px;
  }

  .contact-map-embed {
    overflow: hidden;
    border-radius: var(--standard-radius);
    border: var(--border);
  }

  .map-embed img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>