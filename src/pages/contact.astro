---
import NavbarSiteLayout from "../layouts/NavbarSiteLayout.astro";
import {
  formKey,
  contactEmail,
  contactPhone,
} from "../data/constants";
import Icon from "../components/icon.astro";
import {
mailIcon,
  paperPlane,
phoneIcon,
} from "../data/standard-icons";
import TemplateFormRedirect from "../components/template-form-redirect.astro";
import Image from "astro/components/Image.astro";
import contactImage from "../images/contact-image.jpg";
---

<NavbarSiteLayout
  title="Contact"
  description="Get in touch with us today for a free quote and get started transforming your space!"
>

  <div class="content-chapter">
    <section>

      <div class="image-section-container">
        <Image class="background-image" src={contactImage} alt="" format="avif" quality={35} widths={[760, 310]} />
        <Image class="contact-image" src={contactImage} alt="" format="avif" widths={[800, 480]} />
      </div>

      <div class="form-section">
        <div class="overview">
          <h1 class="section-title">Contact</h1>
          <p class="subtle-text">
            To contact Carole or learn more about the artwork, fill out the form below or call/email directly.
          </p>
        </div>
        <form action="" id="contact-form">
          <input type="hidden" name="access_key" value={formKey} />

          <input
            class="tail-fade"
            type="text"
            id="name"
            name="name"
            placeholder="Name"
            required
          />
          <input
            class="tail-fade"
            type="text"
            id="email"
            name="email"
            placeholder="Email"
            required
          />
          <input
            class="tail-fade"
            type="tel"
            id="phone"
            name="phone"
            placeholder="Phone"
            required
          />
          <textarea
            class="tail-fade"
            id="message"
            name="message"
            rows="5"
            placeholder="Message"
            required></textarea>
        </form>

        <div class="bottom-row">
          <div class="button-row">
            <button class="site-button" type="submit" form="contact-form">
              Send Message
              <Icon src={paperPlane} class="body-icon-sm" />
            </button>
          </div>
          <div class="divider"></div>
          <div class="contact-links">
            <a
              class="contact-link tail-fade underscore-trigger"
              href={`mailto:${contactEmail}`}
            >
              <Icon src={mailIcon} class="contact-icon tail-fade" />
              <span class="underscore">
                {contactEmail}
              </span>
            </a>
            <a
              class="contact-link tail-fade underscore-trigger"
              href={`tel:${contactPhone}`}
            >
              <Icon src={phoneIcon} class="contact-icon tail-fade" />
              <span class="underscore">
                {contactPhone}
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</NavbarSiteLayout>

<TemplateFormRedirect />

<style lang="scss">
  @use "../styles/breakpoints" as *;
  @use "../styles/font-system" as *;
  @use "../styles/column-layouts" as *;

  section {
    display: grid;
    grid-template-columns: 5fr 7fr;
    padding-block: 0;
  }

  /* Form Section */

  form {
    align-items: start;
    margin-bottom: 80px;
  }

  .form-section {
    width: 100%;
    padding-block: var(--section-padding);
    padding-right: var(--side-margin);
    padding-left: var(--section-gap);
    grid-column: 2;
  }

  h1 {
    color: var(--accent-1-color);
  }

  .bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .divider {
    width: 1px;
    height: 4rem;
    background-color: var(--border-color);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .contact-link {
    @extend %accent-font;
    color: var(--accent-1-color);
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding-block: 2px;

    &:hover {
      opacity: 0.8;
    }
  }

  .contact-icon {
    --size: 1.25rem;
    fill: var(--accent-1-color);
  }

  .image-section-container {
    position: relative;
    background-color: rgba(0, 0, 0, 0.4);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: end;
  }

  .background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    filter: blur(16px);
    transform: scale(1.2);
    z-index: -1;
  }

  .contact-image {
    width: col-width(3);
    border-radius: var(--standard-radius);
    margin-left: var(--side-margin);
    margin-right: var(--section-gap);
  }

  @media screen and (max-width: 1200px) {
    section {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .form-section {
      grid-row: 1;
      grid-column: auto;
      max-width: col-width(6);
    }
    .form-section,
    .contact-card {
      padding-inline: var(--side-margin);
    }
    .image-section-container {
      width: 100%;
      justify-content: center;
    }

    .contact-image {
      margin: 0;
    }
  }

  @media screen and (max-width: $breakpoint-sm) {
    .bottom-row {
      flex-direction: column;
      align-items: start;
    }
    .divider {
      height: 1px;
      width: 75%;
      margin-block: 4rem;
    }
  }
</style>
