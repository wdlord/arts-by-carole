---
import {arrowRight, ribbon} from "../data/standard-icons";
import Icon from "../components/icon.astro";

const awards = [
  {
    title: "Blue Ribbon",
    location: "Carlsbad Village Faire",
  },
  {
    title: "Blue Ribbon",
    location: "Escondido Art Show",
  },
  {
    title: "Red Ribbon",
    location: "Carlsbad Village Faire",
  },
  {
    title: "Red Ribbon",
    location: "Carlsbad Village Faire",
  },
];
---
<section class="selected-awards secondary-scheme">
  <div class="left-content">
    <div class="line"></div>
    <div class="actual-content">
      <h2>Selected <span class="second-line">Awards</span></h2>
      <a href="/exhibits-and-recognition" class="site-button">
        View All Exhibits & Awards
        <Icon src={arrowRight} class="body-icon" />
      </a>
    </div>
  </div>
  <div class="awards-grid">
    {
      awards.map(awardItem => (
        <div class="award-card">
          <div class="award-heading">
            <Icon src={ribbon} class="award-icon" />
            {awardItem.title}
          </div>
          <div class="location">{awardItem.location}</div>
        </div>
      ))
    }
  </div>
</section>

<style lang="scss">
  @use "../styles/column-layouts" as *;
  @use "../styles/font-system" as *;
  @use "../styles/breakpoints" as *;

  section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--side-margin);
    gap: var(--section-gap);
  }

  .left-content {
    display: flex;
    align-items: center;
  }

  .line {
    width: 1px;
    background-color: var(--border-color);
    height: 342px;
    margin-right: 5rem;
  }

  .actual-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .awards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    width: 100%;
    max-width: col-width(6);
    margin-right: col-width(1);
  }

  .award-card {
    background-color: var(--white);
    border: var(--border);
    border-radius: var(--standard-radius);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .award-heading {
    display: flex;
    align-items: center;
    @extend %heading-font;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    gap: 0.5rem;
    line-height: 1;
  }

  .award-icon {
    --size: 2rem;
    fill: var(--accent-1-color);
  }

  .location {
    @extend %accent-font;
  }

  @media screen and (max-width: $breakpoint-lg) {
    .line {
      display: none;
    }
  }
  @media screen and (max-width: 1200px) {
    .awards-grid {
      margin-right: 0;
    }
  }

  @media screen and (max-width: $breakpoint-md) {
    section {
      flex-direction: column;
    }
    .actual-content {
      flex-direction: row;
      align-items: center;
    }
  }

  @media screen and (max-width: $breakpoint-sm) {
    .actual-content {
      flex-direction: column;
      
    }
    .awards-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>