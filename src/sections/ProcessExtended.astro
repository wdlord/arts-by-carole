---
import LandscapeImage from "../components/landscape-image.astro";
import ProcessAccordion from "../components/process-accordion.astro";
import processImage from "../images/blue-town-home.jpg";
---

<div class="content-chapter">
  <div class="content-container">
    <section class="landscape-section reversed">
      <div class="img-card">
        <LandscapeImage src={processImage} alt="Blue town-home exterior" />
      </div>
      <div class="text-content">
        <div class="overview">
          <h2>Satisfaction-Driven Process</h2>
          <p class="subtle-text">
            We're proud of the work we do and want you to be just as happy with
            the final results as we are.
          </p>
        </div>
        <ProcessAccordion
          label="Prep the Surfaces"
          details="Cracks repaired, areas sanded, and everything primed correctly."
        />
        <ProcessAccordion
          label="Protect Your Home"
          details="Floors, furniture, and fixtures are fully covered before work begins."
        />
        <ProcessAccordion
          label="Paint With Care"
          details="Skilled application using premium materials for long-lasting results."
        />
        <ProcessAccordion
          label="Final Walkthrough"
          details="You review the work with us to confirm it's exactly what you expected."
        />
        <ProcessAccordion
          label="Clean Up"
          details="We remove all materials and leave your home spotless!"
        />
      </div>
    </section>
  </div>
</div>

<script is:inline>
  const stepNumbers = document.querySelectorAll(".process-item .step-number");
  stepNumbers.forEach((el, i) => {
    el.textContent = `${i + 1}. `;
  });
</script>

<style lang="scss">
  @use "../styles/landscape-section" as *;
</style>
