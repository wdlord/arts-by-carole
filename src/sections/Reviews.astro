---
import ReviewCard from "../components/review-card.astro";
import Carousel from "../components/carousel.astro";
import googleReviewLogo from "../images/google-review-logo.png";
import { reviews } from "../data/reviews";

const gap = "24px";
---

<div class="content-chapter secondary-scheme">
  <div class="content-container">
    <section class="reviews">
      <div class="review-header">
        <div class="overview">
          <h2>Loved by Clients</h2>
          <p class="desc subtle-text">
            We're proud to deliver work that goes beyond expectations. Our
            clients' words reflect the care, quality, and trust that define
            every project we take on.
          </p>
        </div>
        <img
          class="g-review-logo"
          src={googleReviewLogo.src}
          alt="Google Reviews 5 star logo"
        />
      </div>

      <Carousel gap={gap} itemCount={reviews.length}>
        {
          reviews.map((review) => (
            <ReviewCard text={review.text} name={review.name} gap={gap} />
          ))
        }
      </Carousel>
    </section>
  </div>
</div>

<style lang="scss">
  @use "../styles/breakpoints" as *;

  .content-container {
    overflow: hidden;
    width: 100%;
  }

  .review-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 64px;
  }

  .g-review-logo {
    max-width: 132px;
  }

  .reviews {
    overflow: hidden;
    width: 100%;
  }

  .desc {
    max-width: var(--half-width);
  }

  @media screen and (max-width: $breakpoint-md) {
    .review-header {
      flex-direction: column;
      justify-content: flex-start;
      align-items: start;
      gap: 24px;
      margin-bottom: 1.5rem;
    }
    .overview {
      margin-bottom: 0;
    }
  }
</style>
