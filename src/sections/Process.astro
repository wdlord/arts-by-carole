---
import Icon from "../components/icon.astro";
import {doubleChevronRight} from "../data/standard-icons";

const steps = [
    {
        title: "Consultation",
        description: "Our experts meet with you to determine a free quote based on the scale and complexity of the project."
    },
    {
        title: "Contract",
        description: "We review the scope of the project contract and ensure everyone is satisfied."
    },
    {
        title: "Work",
        description: "Once the contract is signed, we begin work on construction following the project timeline."
    },
    {
        title: "Completion",
        description: "When the project is finished we clean and follow up with you comprehensively to ensure satisfaction."
    }
]
---

<div class="content-chapter">
    <div class="content-container">
        <section class="process">
            <span class="subheading">Reliable Results</span>
            <h2>Our Process</h2>
            <div class="process-grid">
                {
                    steps.map((step, index) => (
                        <div class="process-item tail-fade-long">
                            <div class="title">{step.title}</div>
                            <span class="step tail-fade">
                                Step {index+1}
                                <Icon class="step-icon" src={doubleChevronRight}/>
                            </span>
                            <p class="subtle-text">
                                {step.description}
                            </p>
                        </div>
                    ))
                }
            </div>
        </section>
    </div>
</div>

<style lang="scss">
    @use "../styles/breakpoints" as *;
    @use "../styles/font-system" as *;
    
    h2 {
        margin-bottom: 64px;
    }

    .process-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 88px 48px;
    }

    .process-item:hover {
        transform: translateY(-1rem);

        .step {
            background-color: var(--accent-1-color);
            color: var(--accent-1-text);
            fill: var(--accent-1-text);
        }
    }

    .title {
        @extend %heading-font;
        font-size: var(--size-h3);
        margin-bottom: 1rem;
    }

    .step {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-family: var(--font-accent);
        font-size: 0.75rem;
        text-transform: uppercase;
        padding: 4px 16px;
        border-radius: 5vmin;
        margin-bottom: 1.5rem;
        background-color: var(--accent-1-text);
        color: var(--accent-1-color);
        fill: var(--accent-1-color);
        border: 1px solid var(--accent-1-color);
    }

    .step-icon {
        width: 0.75rem;
        height: 0.75rem;
    }

    @media screen and (max-width: $breakpoint-lg) {
        .process-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media screen and (max-width: $breakpoint-md) {
        .process {
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .process-grid {
            grid-template-columns: 1fr;
            max-width: var(--third-width);
        }
        .process-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;

            &:hover {
                transform: translateY(0px);
            }
        }
    }

    @media screen and (max-width: $breakpoint-sm) {
        .process {
            align-items: start;
        }
        .process-grid {
            gap: 48px;
        }
        .process-item {
            align-items: start;
            text-align: left;
        }
    }
</style>