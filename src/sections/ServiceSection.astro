---
import { ctaLink, ctaTarget } from "../data/constants";
import { labelToID } from "../scripts/navigation";
import LandscapeImage from "../components/landscape-image.astro";

interface Props {
  title: string;
  img: ImageMetadata;
  alt: string;
  isAlternate?: boolean;
}

const { title, img, alt, isAlternate = false } = Astro.props;

const side = isAlternate ? "reversed" : "";
const scheme = isAlternate ? "secondary-scheme" : "primary-scheme";
const id = labelToID(title);
---

<div id={id} class=`content-chapter ${scheme}`>
  <div class="content-container">
    <section class=`landscape-section ${side}`>
      <div class="img-card">
        <LandscapeImage src={img} alt={alt} />
      </div>
      <div class="text-content">
        <h2>{title}</h2>
        <slot />
        <a class="site-button" href={ctaLink} target={ctaTarget}
          >Get in Touch!</a
        >
      </div>
    </section>
  </div>
</div>

<style lang="scss">
  @use "../styles/landscape-section" as *;

  .site-button {
    margin-top: 2.25rem;
  }
</style>
