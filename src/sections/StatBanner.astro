---
import { arrowRight } from "../data/standard-icons";
import Icon from "../components/icon.astro";

const stats = [
  {
    stat: `24+`,
    label: ["exhibitions"],
  },
  {
    stat: "11+",
    label: ["awards"],
  },
];
---

<div class="content-chapter secondary-scheme">
  <div class="content-container">
    <section class="half-section stats">
      <div class="stat-container">
        {
          stats.map((data) => (
            <div class="stat-underscore underscore-trigger">
              <div class="stat tail-fade-long accent underscore">
                <span class="stat-heading">{data.stat}</span>
                {data.label[0]}
                <span class="second-line">{data.label[1]}</span>
              </div>
            </div>
          ))
        }
        <a href="/gallery/art-gallery/" class="site-button">
          View Full Gallery
          <Icon src={arrowRight} class="body-icon" />
        </a>
      </div>
    </section>
  </div>
</div>

<style lang="scss">
  @use "../styles/breakpoints" as *;
  @use "../styles/font-system" as *;

  section {
    padding-block: 244px;
  }

  .stats {
    display: flex;
    justify-content: center;
  }

  .stat-container {
    display: flex;
    align-items: center;
    gap: 96px;
  }

  .stat-underscore {
    padding-right: 4rem;
    border-right: 1px solid var(--border-color);
    padding-block: 0.5rem;
  }

  .stat {
    @extend %accent-font;
    line-height: 1.4;
    font-size: 1.125rem;
  }

  .stat-heading {
    @extend %heading-font;
    font-size: 4rem;
    display: block;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  @media screen and (max-width: 800px) {
    section {
      padding-block: var(--section-padding);
    }
    .stat-container {
      flex-direction: column;
      gap: 3rem;
    }
    .stat-underscore {
      padding-inline: 0;
      border-right: none;
    }
  }
</style>
