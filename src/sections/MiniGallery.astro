---
import Icon from "../components/icon.astro";
import {arrowRight} from "../data/standard-icons";
import image1 from "../images/room-with-brown-walls.jpg";
import image2 from "../images/house-with-black-door.jpg";
import image3 from "../images/contact-bg.jpg";
import image4 from "../images/white-and-gray-kitchen.jpg";
import image5 from "../images/spacious-kitchen.jpg";
import CallNowButton from "../components/call-now-button.astro";
import Picture from "astro/components/Picture.astro";
import { mainLocation, yoe } from "../data/constants";

const topRowImages = [
  {
    src: image1,
    alt: "Freshly painted room with warm brown walls and clean hardwood",
    hoverText: "Carlsbad, CA",
  },
  {
    src: image2,
    alt: "Newly painted House with black door and white exterior",
    hoverText: "Encinitas, CA",
  },
  {
    src: image3,
    alt: "Exterior image of a new beach-style home",
    hoverText: "Carlsbad, CA",
  }
];

const bottomRowImages = [
  {
    src: image4,
    alt: "Clean and modern white and gray kitchen",
    hoverText: "Poway, CA",
  },
  {
    src: image5,
    alt: "Spacious kitchen with beautiful hardwood",
    hoverText: "Del Mar, CA",
  },
];
---

<div class="content-chapter">
    <section class="mini-gallery">
      <div class="top-row">
        {
          topRowImages.map(img => (
            <div class="gallery-item">
              <div class="hover-text tail-fade-long">
                {img.hoverText}
              </div>
              <Picture 
                src={img.src}
                alt={img.alt}
                widths={[360, 640, 880]}
                formats={["avif", "webp", "jpeg"]}
              />
            </div>
          ))
        }
      </div>
      <div class="cta-banner tertiary-scheme">
        <h2>Proudly painting {mainLocation} for {yoe}+ years</h2>
        <div class="button-row">
          <CallNowButton class="site-button" />
          <a class="site-button" href="/gallery">
            View Full Gallery
            <Icon src={arrowRight} class="body-icon-sm" />
          </a>
        </div>
      </div>
      <div class="bottom-row">
        {
          bottomRowImages.map(img => (
            <div class="gallery-item">
              <div class="hover-text tail-fade-long">
                {img.hoverText}
              </div>
              <Picture 
                src={img.src}
                alt={img.alt}
                widths={[640, 960, 1200]}
                formats={["avif", "webp", "jpeg"]}
              />
            </div>
          ))
        }
      </div>
    </section>
</div>

<style lang="scss">
  @use "../styles/breakpoints" as *;
  @use "../styles/buttons" as *;
  @use "../styles/font-system" as *;

  h2 {
    font-size: 2rem;
  }

  section {
    padding: 0;
  }
  
  .cta-banner {
    padding-block: calc(var(--section-padding) / 2);
    padding-inline: var(--side-margin);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--section-gap);
  }

  .top-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .bottom-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .gallery-item {
    width: 100%;
    aspect-ratio: 3/2;
    overflow: hidden;
    position: relative;
  }

  .hover-text {
    @extend %heading-font;
    letter-spacing: 0.01em;
    line-height: 1.1;
    position: absolute;
    background: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.5));
    color: white;
    height: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: end;
    text-align: right;
    padding: 1rem 3rem;
    opacity: 0;

    &:hover {
      opacity: 1;
    }
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .site-button:last-of-type {
    --bg-color: white;
    --text-color: var(--base-text);
  }

  .site-button {
    --hover-color: white;
  }

  @media screen and (max-width: $breakpoint-md) {
    .top-row .gallery-item {
      aspect-ratio: 1;
    }
    .cta-banner {
      flex-direction: column;
      gap: 40px;
      text-align: center;
    }
    .button-row {
      justify-content: center;
    }
    .hover-text {
      padding-right: 2rem;
    }
  }

  @media screen and (max-width: $breakpoint-sm) {
    .top-row {
      grid-template-columns: 1fr 1fr;
    }
    .bottom-row {
      grid-template-columns: 1fr;
    }
    .top-row > .gallery-item:last-child,
    .bottom-row > .gallery-item:last-child {
      display: none;
    }
    .hover-text {
      padding-right: 1rem;
    }
  }
</style>