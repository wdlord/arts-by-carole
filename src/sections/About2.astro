---
import Icon from "../components/icon.astro";
import {commentHeart, brush, store, shieldCheck} from "../data/standard-icons";
import aboutImage from "../images/about-2-image.jpg";
import { ctaLink, ctaTarget } from "../data/constants";
import { arrowRight } from "../data/standard-icons";
import LandscapeImage from "../components/landscape-image.astro";

const values = [
  {
    icon: commentHeart,
    name: 'Client-Focused',
  },
  {
    icon: brush,
    name: 'Premium Materials',
  },
  {
    icon: store,
    name: 'Locally Owned',
  },
  {
    icon: shieldCheck,
    name: 'Experienced Team',
  },
];
---

<div class="content-chapter secondary-scheme">
  <div class="content-container">
    <section class="portrait-section">
      <div class="img-card">
        <LandscapeImage
          src={aboutImage}
          alt="Two team-members painting a building interior"
        />
      </div>
      <div class="text-content">
        <div class="overview">
          <h2>X's Choice for High Quality Painting</h2>
          <p class="subtle-text">
            We're proud to serve X with painting services built on
            honesty, quality, and a commitment to doing things the right way.
            Whether it's refreshing a single room or transforming an entire
            property, our team focuses on clear communication, careful
            workmanship, and results you'll enjoy for years.
          </p>
        </div>
        <div class="values">
          {
            values.map(value => (
              <div class="value-item">
                <div class="icon-bg">
                  <Icon src={value.icon} class="value-icon"/>
                </div>
                {value.name}
              </div>
            ))
          }
        </div>
        <a href={ctaLink} target={ctaTarget} class="site-button">
          Get a Quote
          <Icon src={arrowRight} class="body-icon-sm"/>
        </a>
      </div>
    </section>
  </div>
</div>

<style lang="scss">
  @use "../styles/breakpoints" as *;
  @use "../styles/font-system" as *;
  @use "../styles/portrait-section" as *;

  .values {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 24px;
    margin-bottom: 4rem;
  }

  .value-item {
    @extend %heading-font;
    font-size: var(--size-h3);
    font-weight: var(--weight-h3);
    background-color: var(--base-color);
    border: var(--border);
    border-radius: var(--standard-radius);
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px;
  }

  .icon-bg {
    width: 40px;
    aspect-ratio: 1;
    border-radius: 50%;
    border: var(--border);
    background-color: var(--alt-color);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .value-icon {
    --size: 1.5rem;
    fill: var(--accent-1-color);
  }

  @media screen and (max-width: 1200px) {
    .values {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: $breakpoint-md) {
    section::after {
      display: none;
    }
    .values {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media screen and (max-width: 800px) {
    .values {
      grid-template-columns: 1fr;
    }
  }
</style>
