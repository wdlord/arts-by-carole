---
import { Image } from "astro:assets";
import awardsGreenRibbon from "../images/awards-green-ribbon.jpg";
import awardsWearingRed from "../images/awards-wearing-red.jpg";
import awardsWearingJacket from "../images/awards-wearing-jacket.jpg";
import awardsBlueRibbon from "../images/awards-blue-ribbon.jpg";
import { getCollection } from 'astro:content';

const exhibits = (await getCollection('pastExhibits'))
  .sort((a, b) => Number(a.id) - Number(b.id));
---

  <section class="past-exhibits">
    <div class="image-layout">
      <div class="image-column">
        <Image src={awardsWearingJacket} alt="" class="grid-image img-card" />
        <Image src={awardsGreenRibbon} alt="" class="grid-image img-card" />
      </div>
      <div class="image-column">
        <Image src={awardsWearingRed} alt="" class="grid-image img-card" />
        <Image src={awardsBlueRibbon} alt="" class="grid-image img-card" />
      </div>
    </div>
    <div class="text-content">
      <h2>Past<span class="second-line">Exhibits</span></h2>
      <div class="timeline">
        {
          exhibits.map(exhibit => (
            <div class="exhibit">
              <div class="exhibit-title">
                {exhibit.data.title}
              </div>
              <div class="exhibit-description subtle-text">
                {exhibit.data.description}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</div>

<style lang="scss">

  @use "../styles/column-layouts" as *;
  @use "../styles/font-system" as *;
  @use "../styles/breakpoints" as *;

  section {
    padding-inline: var(--side-margin);
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: calc(col-width(1) + 2 * var(--gutter-width));
  }

  .image-layout {
    display: flex;
    gap: 1rem;
  }

  .image-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 50%;
  }

  .image-column:last-of-type {
    padding-top: 5rem;
  }

  h2 {
    padding-left: 1.5rem;
    margin-bottom: var(--section-gap);
  }

  .grid-image {
    aspect-ratio: 3/4;
  }

  .timeline {
    padding-left: 1.5rem;
    border-left: 1px solid rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
    gap: 10rem;
  }

  .exhibit {
    max-width: col-width(3);
  }

  .exhibit-title {
    @extend %accent-font;
    color: var(--accent-1-color);
    margin-bottom: 2rem;
    position: relative;
  }

  .exhibit-title::before {
    content: "";
    position: absolute;
    display: block;
    width: 13px;
    aspect-ratio: 1;
    border-radius: 50%;
    background-color: var(--base-color);
    border: 1px solid rgba(0, 0, 0, 0.2);
    left: -2rem;
    top: 25%;
  }

  @media screen and (max-width: $breakpoint-md) {
    section {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4rem;
    }
    .image-layout {
      max-width: col-width(4);
    }
  }

  @media screen and (max-width: $breakpoint-sm) {
    .timeline {
      gap: 6rem;
    }
  }
</style>