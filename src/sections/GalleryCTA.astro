---
import Icon from "../components/icon.astro";
import { arrowRight } from "../data/standard-icons";
---

<section class="gallery-cta secondary-scheme">
  <div class="border-container">
    <h2>View the full gallery.</h2>
    <a href="/gallery/art-gallery/" class="site-button">
      Explore Gallery
      <Icon src={arrowRight} class="body-icon" />
    </a>
  </div>
</section>

<style lang="scss">
  .gallery-cta {
    padding-inline: var(--side-margin);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-block: 0.5rem;
  }

  .border-container {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2.5rem var(--section-gap);
    width: 100%;
    max-width: 83%;
    border-top: var(--border);
    padding-block: 10rem;
    text-align: center;
  }
</style>