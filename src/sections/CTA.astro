---
import CallNowButton from "../components/call-now-button.astro";
import CtaButton from "../components/cta-button.astro";
---

<div class="content-chapter">
  <div class="content-container">
    <section class="cta">
      <h2 class="cta-heading">
        Ready to get started?
        <span class="second-line">Get in touch today.</span>
      </h2>
      <div class="button-row">
        <CtaButton />
        <CallNowButton />
      </div>
    </section>
  </div>
</div>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-heading {
    text-align: center;
    margin-bottom: 2rem;
  }

  .button-row {
    justify-content: center;
  }
</style>
