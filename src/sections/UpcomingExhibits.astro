---
import { Image } from "astro:assets";
import Icon from "../components/icon.astro";
import { locationDot } from "../data/standard-icons";
import backgroundImage from "../images/exhibits-bg.jpg";

const exhibitData = [
  {
    title: "Escondido Art Show",
    location: "Escondido, CA",
    date: "Aug 1 – Aug 31, 2026",
    description: "Stop by the Carlsbad Village Faire during the month of September to see a selection of my favorite artwork."
  },
  {
    title: "Escondido Art Show",
    location: "Escondido, CA",
    date: "Aug 1 – Aug 31, 2026",
    description: "Stop by the Carlsbad Village Faire during the month of September to see a selection of my favorite artwork."
  },
  {
    title: "Escondido Art Show",
    location: "Escondido, CA",
    date: "Aug 1 – Aug 31, 2026",
    description: "Stop by the Carlsbad Village Faire during the month of September to see a selection of my favorite artwork."
  }
];

---

<section class="upcoming-exhibits">

  <div class="section-background">
    <div class="card-layout-background"></div>
    <div class="image-section-background">
      <div class="text-content">
        <div class="line"></div>
        <h2>Current <div class="second-line">& Upcoming</div><div class="second-line">Exhibits</div></h2>
      </div>
      <div class="section-background-overlay"></div>
      <div class="background-image-container">
        <Image src={backgroundImage} class="background-image" alt="" />
      </div>
    </div>
  </div>

  <div class="card-layout">
    {
      exhibitData.map(exhibit => (
        <div class="exhibit-card">
          <div class="card-header">
            <div class="title">{exhibit.title}</div>
            <div class="line"></div>
          </div>
          <div class="location-row">
            <Icon src={locationDot} class="location-icon"/>
            <div class="location">{exhibit.location}</div>
          </div>
          <div class="date subtle-text">{exhibit.date}</div>
          <div class="description subtle-text">
            {exhibit.description}
          </div>
        </div>
      ))
    }
  </div>

  
</section>

<style lang="scss">
  @use "../styles/column-layouts" as *;
  @use "../styles/font-system" as *;
  @use "../styles/breakpoints" as *;

  section {
    position: relative;
    padding: 0;
    z-index: -1;
  }

  .section-background {
    position: absolute;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
  }

  .card-layout-background {
    width: col-width(3);
    flex-shrink: 0;
    height: 100%;
    background-color: var(--alt-color);
  }

  .image-section-background {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .section-background-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    right: 0;
    z-index: -10;
    background-color: rgba(0, 0, 0, 0.4);
  }

  .background-image-container {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    right: 0;
    z-index: -20;
    overflow: hidden;
  }

  .background-image {
    filter: blur(4px);
    transform: scale(1.04);
    height: 100%;
  }

  .card-layout {
    position: relative;
    padding-block: var(--section-padding);
    padding-left: var(--side-margin);
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .exhibit-card {
    width: 100%;
    max-width: col-width(4);
    border-radius: var(--standard-radius);
    border: var(--border);
    padding: 4rem 2.5rem;
    box-shadow: var(--card-shadow);
    background-color: var(--base-color);
  }

  .card-header {
    gap: 5rem;
    display: flex;
    align-items: center;
  }

  .title {
    @extend %heading-font;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .line {
    height: 1px;
    width: 100%;
    background-color: var(--border-color);
  }

  .location-row {
    @extend %accent-font;
    color: var(--accent-1-color);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .location-icon {
    --size: 1rem;
  }

  .date {
    margin-bottom: 2.5rem;
  }

  .text-content {
    position: fixed;
    margin-top: var(--section-padding);
    color: var(--white);
    display: flex;
    align-items: center;
    gap: var(--section-gap);
    left: 60%;
  }

  .text-content .line {
    background-color: var(--white);
    width: 1px;
    height: 256px;
  }

  @media screen and (max-width: $breakpoint-md) {
    section {
      overflow: hidden;
    }
    .section-background {
      flex-direction: column-reverse;
    }
    .card-layout-background {
      display: none;
    }
    .image-section-background {
      display: flex;
      justify-content: center;
      align-items: start;
    }
    .text-content {
      position: static;
    }
    .card-layout {
      align-items: center;
      margin-top: 20rem;
      gap: 2rem;
      padding-inline: var(--side-margin);
    }
  }

  @media screen and (max-width: $breakpoint-sm) {
    .exhibit-card {
      padding: 2.5rem 2rem;
    }

    .location-row, .date {
      margin-bottom: 1.5rem;
    }
  }

</style>