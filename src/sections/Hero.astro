---
import CtaButton from "../components/cta-button.astro";
import Icon from "../components/icon.astro";
import {arrowRight} from "../data/standard-icons";
import Picture from "astro/components/Picture.astro";
import portrait from "../images/main-pic.jpg";
---

<div class="hero-container hero-height">
  <section class="hero-section">
    <div class="text-content">
      <span class="subheading">Fine Art & Ephemera</span>
      <h1 class="title">
        Carole <div class="second-line">Quinn-Nylander</div>
      </h1>
      <p class="desc subtle-text">
        Through oil and watercolor, Carole seeks to capture more than what the eye sees, celebrating the beauty of our world while exploring the emotions, stories, and human experiences within it.
      </p>

      <div class="button-row">
        <CtaButton text="Get in Touch" />
        <a href="/gallery/art/" class="ghost">
          Explore Gallery
          <Icon src={arrowRight} class="body-icon" />
        </a>
      </div>
    </div>
    <div class="image-container">
      <Picture class="portrait" src={portrait} alt="A professional portrait of Carole Quinn-Nylander posing with a painting of a cowboy in a bar or saloon, pictured in her home." />
    </div>
  </section>
</div>

<style lang="scss">
  @use "../styles/font-system" as *;
  @use "../styles/breakpoints" as *;
  @use "../styles/column-layouts" as *;

  section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
    padding-block: 0;
    padding-inline: var(--side-margin);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr min-content;
  }

  .hero {
    position: relative;
    overflow: hidden;
    color: var(--accent-1-color);
  }

  .title {
    max-width: var(--half-width);
    margin-bottom: 2rem;
    position: relative;
  }

  .title::before {
    content: "";
    display: block;
    width: 1px;
    height: 260px;
    background-color: var(--border-color);
    position: absolute;
    right: 0;
    top: -310px;
  }

  .subheading {
    margin-bottom: 2rem;
  }

  h1 .second-line, .desc, .button-row {
    margin-left: calc(col-width(1) + var(--gutter-width));
  }

  .content-container {
    display: flex;
    justify-content: left;
  }

  .desc {
    position: relative;
    margin-bottom: 40px;
    max-width: col-width(4);
  }

  .desc::before {
    content: "";
    display: block;
    width: 1px;
    height: 260px;
    background-color: var(--border-color);
    position: absolute;
    top: 10px;
    left: calc(-1 * (col-width(1) + var(--gutter-width)));
  }

  .image-container {
    height: 100%;
    width: col-width(5);
  }

  .portrait {
    width: 100%;
    height: 100%;
    object-position: right;
  }

  @media screen and (max-width: $breakpoint-lg) {
    section {
      padding-right: 0;
    }

    .image-container {
      width: col-width(4);
    }
  }

  @media screen and (max-width: 1200px) {
    h1 .second-line, .desc, .button-row {
      margin-left: 0;
    }

    desc::before {
      display: none;
    }

    .image-container {
      width: col-width(3);
    }
  }

  @media screen and (max-width: $breakpoint-md) {
    section {
      margin-block: var(--side-margin);
      flex-direction: column;
      gap: 4rem;
      padding-inline: 0;
    }

    .image-container {
      width: 100%;
      height: 500px;
    }

    .portrait {
      object-position: top;
    }

    .text-content {
      margin-inline: var(--side-margin);
    }
  }

  @media screen and (max-width: $breakpoint-sm) {
    section {
      padding-block: 4rem;
    }
  }
</style>
