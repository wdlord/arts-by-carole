---
import Picture from "astro/components/Picture.astro";
---

<div class="content-chapter page-heading accent-1-scheme">
    <div class="content-container">
      <section class="heading-container half-section">
        <slot/>
      </section>
    </div>
</div>

<style>

  .heading-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    color: white;
  }
  :global(.page-heading h1) {
    margin-bottom: 0;
  }
  :global(.page-heading p) {
    margin-top: 24px;
  }
</style>