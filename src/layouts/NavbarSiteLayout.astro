---
import "../styles/global.scss";
import Navbar from "../components/navbar.astro"
import Footer from "../components/footer.astro"
import {contactPhone, siteName, siteUrl, isTemplate} from "../data/constants"

// Title info:
// https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/title

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { 
  title = '', // ~65 max
  description = '', // ~160 max
  noindex = false, // when set to true, output <meta name="robots" content="noindex"> for this page
} = Astro.props;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteName,
  "url": siteUrl,
  "logo": `${siteUrl}/logos/pilot-painting-wordmark.svg`,
  "sameAs": [],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": contactPhone,
    "contactType": "customer service",
    "areaServed": "US",
    "availableLanguage": ["English"]
  }
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "alternateName": siteName,
  "url": siteUrl
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{`${title} | ${siteName}`}</title>
    <meta name="description" content={description} />
    {(noindex || isTemplate) && <meta name="robots" content="noindex, follow">}

    <!-- Open Graph / Twitter Cards here -->

    <!-- Sitemap Link -->
     <link rel="sitemap" href="/sitemap-index.xml" />
    
    <!-- Generate Favicons Here: https://favicon.io/favicon-converter/ -->
    <!-- Basic Favicon -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">

    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts -->
    <link rel="stylesheet" href="/fonts/fonts.css">

    <!-- Example of preloading a font file (please convert to woff2 first) -->
    <link rel="preload" href="/fonts/radio-canada-big-v3-latin-500.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href="/fonts/radio-canada-big-v3-latin-700.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href="/fonts/raleway-v37-latin-500.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href="/fonts/raleway-v37-latin-600.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href="/fonts/roboto-v49-latin-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    
    <!-- Org Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!-- Website Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body>
    <div class="layout-wrapper">
      <Navbar />
      <main class="page-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .layout-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    width: 100%;
    align-items: center;
  }

  .page-content {
    width: 100%;
    flex-grow: 1;
    position: relative;
    overflow: hidden;
    padding-top: var(--nav-height);
  }
</style>