---
import ToTopButton from '../components/to-top-button.astro';
import FilterMenu from '../components/filter-menu.astro';
import Lightbox from '../components/lightbox.astro';

interface Props {
  pageHeading: string;
  tags: string[];
}

const {
  pageHeading,
  tags,
} = Astro.props;
---

<div class="gallery-layout-container">
  <ToTopButton />
  <Lightbox />
  <div class="gallery-layout-content">
    <section class="gallery-overview">
      <h1 class="page-title">{pageHeading}</h1>
      <div class="desc">
        <slot name="gallery-description"/>
      </div>
    </section>

    <hr>

    <div class="filter-menu-container">
      <FilterMenu tags={tags} />
    </div>

    <div class="gallery-items">
      <slot name="gallery-items" />
    </div>
  </div>
</div>

<script is:inline>
  // Set up cards to dispatch event
  document.querySelectorAll('.gallery-card').forEach(card => {
    card.addEventListener('click', () => {
      const data = JSON.parse(card.dataset.lightbox);

      document.dispatchEvent(
        new CustomEvent('open-gallery-modal', {
          detail: data,
        })
      );
    });
  });
</script>

<style lang="scss">
  @use "../styles/breakpoints" as *;
  @use "../styles/column-layouts" as *;

  .gallery-layout-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: var(--section-padding);
  }

  .gallery-layout-content {
    max-width: col-width(9);
    margin-inline: var(--side-margin);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 104px;
  }

  .gallery-overview {
    padding: 0;
    width: 100%;
    min-width: 0;
    max-width: col-width(6);
    text-align: center;
  }

  .page-title {
    margin-bottom: 4rem;
  }

  .desc {
    color: var(--subtle-text);
  }

  .desc p {
    margin-bottom: 1rem;
  }

  .filter-menu-container {
    width: 100%;
    display: flex;
    justify-content: flex-end;
  }

  .gallery-items {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem 5rem;
  }

  @media screen and (max-width: $breakpoint-md) {
    .gallery-items {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: $breakpoint-sm) {
    .gallery-items {
      grid-template-columns: 1fr;
    }
  }
</style>