---
import Picture from "astro/components/Picture.astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}

const { src, alt, class: className, ...rest } = Astro.props;
---
<Picture
  class={className}
  src={src}
  alt={alt}
  fit="cover"
  formats={["avif", "webp", "jpeg"]}
  widths={[480, 880, 1200, 1600]}
  {...rest}
/>