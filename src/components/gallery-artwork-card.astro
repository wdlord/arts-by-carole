---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  item: CollectionEntry<'artwork'>;
}

const {
  item,
} = Astro.props;

const availability = item.data.available ? 'Available' : 'Sold';
const categoryString = item.data.categories.join(',');
const lightboxData = {
  image: item.data.image,
  title: item.data.title,
  description: item.data.description,
}
---

<div
  class="gallery-card"
  data-categories={categoryString}
  data-lightbox={JSON.stringify(lightboxData)}
>
  <Image class="thumbnail img-card" src={item.data.image} alt=""/>
  <div class="title">{item.data.title}</div>
  <div class="medium-and-size">
    <div class="medium">{item.data.medium}</div>
    <div class="divider"></div>
    <div class="size">{item.data.size}</div>
  </div>
  <div class="availability">{availability}</div>
</div>

<style lang="scss">
  @use "../styles/font-system" as *;

  .thumbnail {
    aspect-ratio: 1;
    width: 100%;
    margin-bottom: 2.5rem;
  }

  .title {
    @extend %accent-font;
  }

  .medium-and-size {
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .divider {
    width: 1px;
    height: 1rem;
    background-color: var(--base-text);
    transform: translateZ(0);
  }

  .availability {
    font-size: 0.875rem;
    font-style: italic;
  }
</style>