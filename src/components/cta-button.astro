---
import { ctaLink, ctaTarget } from "../data/constants";

interface Props {
  text?: string;
  class?: string;
}

const { text = "Get in Touch", class: className, ...rest } = Astro.props;

// Only use noopener noreferrer if our CTA is using target _blank (prevents )
const rel = ctaTarget == "_blank" ? "noopener noreferrer" : "";
---

<a
  class={`site-button ${className}`}
  href={ctaLink}
  target={ctaTarget}
  rel={rel}
  {...rest}
>
  {text}
</a>
