---

const {
  class: className,
  ...rest
} = Astro.props;
---

<div class=`map-embed ${className}` {...rest} >
  <iframe
  title="Google Maps Embed"
  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3341.4802303506444!2d-117.08568502432287!3d33.12274607352101!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80dbf49db3764263%3A0x441ddfaa288e0a48!2sEscondido%20City%20Hall!5e0!3m2!1sen!2sus!4v1764977329699!5m2!1sen!2sus"
  width="600"
  height="450"
  style="border:0;"
  allowfullscreen=""
  loading="lazy"
  referrerpolicy="no-referrer-when-downgrade"></iframe>
</div>

<style>
  .map-embed {
    height: 100%;
    width: 100%;
  }
  iframe {
    width: 100%;
    height: 100%;
  }
</style>