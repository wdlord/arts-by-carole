---
import Icon from "./icon.astro";
import { close } from "../data/standard-icons";
---

<div
  id="gallery-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Image Viewer"
>
  <div class="top-controls">
    <button id="gallery-close-button" aria-label="Close">
      <Icon src={close} class="close-icon" />
    </button>
  </div>
  <div class="img-container">
    <div class="spinner"></div>
    <img id="modal-image" class="hidden" src="" alt="" />
  </div>
  <div id="image-description"></div>
</div>

<script is:inline>
  const galleryModal = document.getElementById("gallery-modal");
  const modalImage = document.getElementById("modal-image");
  const closeButton = document.getElementById("gallery-close-button");
  const imageDescription = document.getElementById("image-description");
  const spinner = document.querySelector(".spinner");
  let lastFocusedButton = null;

  // Do this on open
  document.addEventListener("open-gallery-modal", (event) => {
    const lightboxData = event.detail;
    console.log(lightboxData);

    // Show modal
    galleryModal.style.display = "flex";

    // Set desc
    imageDescription.textContent = lightboxData.description;
    if (lightboxData.description) {
      imageDescription.style.display = 'block';
    }

    // Toggle class to lock body scroll
    document.body.classList.add("modal-open");

    // Set focus to close button
    closeButton.focus();

    setSlide();

    // button event listeners
    closeButton.addEventListener("click", closeModal);

    function setSlide() {
      // hide image and show spinner
      spinner.style.display = "block";
      modalImage.classList.add("hidden");

      console.log('setting slide', lightboxData.image.src);

      // update src and content
      modalImage.src = lightboxData.image.src;
      modalImage.alt = lightboxData.image.alt;

      // queue image to show when load is done
      modalImage.onload = () => {
        spinner.style.display = "none";
        modalImage.classList.remove("hidden");
      };
    }

    // close on BG click
    galleryModal.addEventListener("click", (e) => {
      // Only close if user clicks on background, not the image itself
      if (e.target === galleryModal) {
        closeModal();
      }
    });

    // actual close function
    function closeModal() {
      galleryModal.style.display = "none";
      document.body.classList.remove("modal-open");
      if (lastFocusedButton) lastFocusedButton.focus(); // Restore focus
    }
  });

</script>

<style lang="scss">
  @use "../styles/font-system" as *;
  @use "../styles/breakpoints" as *;

  :global(body.modal-open) {
    overflow: hidden;
  }

  #gallery-modal {
    display: none;
    height: 100dvh;
    height: 100svh; /* fallback for Safari */
    width: 100vw;
    background-color: rgba(0, 0, 0, 0.8);
    color: white;
    fill: white;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 200;
    flex-direction: column;
    justify-content: safe center;
    align-items: center;
    gap: 1.5rem;
    padding: 2rem;
    overflow: auto;
  }

  #modal-image {
    max-width: 80vw;
    max-height: 80vh;
    object-fit: contain;
    transition: opacity 0.3s ease;
  }

  .top-controls {
    margin-left: auto;
  }

  #gallery-close-button {
    background-color: transparent;
    border: none;
    cursor: pointer;

    &:hover {
      opacity: 0.75;
    }
  }

  .close-icon {
    --size: 2rem;
  }

  #image-description {
    display: none;
    white-space: pre-line;
  }

  .img-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin-block: auto;
  }

  .bottom-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
  }

  #gallery-prev-button,
  #gallery-next-button {
    background-color: transparent;
    border: none;
    cursor: pointer;

    &:hover {
      opacity: 0.75;
    }
  }

  .traversal-icon {
    --size: 2rem;
  }

  #slide-number {
    @extend %accent-font;
    font-size: 1.5rem;
  } 

  .spinner {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    border: 4px solid #ccc;
    border-top-color: #444;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    transition: opacity 0.15s ease;
    z-index: 2;
  }

  .hidden {
    opacity: 0;
  }

  @keyframes spin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  @media screen and (max-width: $breakpoint-sm) {
    #modal-image {
      max-width: 100%;
    }
    #gallery-modal {
      padding: 2rem 1.5rem;
    }
  }
</style>