---
import Icon from "./icon.astro";
import { arrowRight } from "../data/standard-icons";
import Picture from "astro/components/Picture.astro";
import { labelToID } from "../scripts/navigation";

interface Props {
  title: string;
  img: ImageMetadata;
  imgAlt: string;
  isFeatured?: boolean;
  featureText?: string;
}

const {
  title,
  img,
  imgAlt,
  isFeatured = false,
  featureText = "",
} = Astro.props;

const link = `/services#${labelToID(title)}`;
---

<div class="service-card">
  <div class="upper-content">
    <div class="card-thumbnail">
      <Picture
        src={img}
        alt={imgAlt}
        widths={[400, 600, 800]}
        formats={["avif", "webp", "jpeg"]}
        />
    </div>
    <div class="card-body">
      {
        isFeatured && (
          <span class="featured accent-1-scheme shadow">{featureText}</span>
        )
      }
      <div class="card-title">{title}</div>
      <p class="desc subtle-text">
        <slot />
      </p>
    </div>
  </div>
  <div class="card-footer">
    <a href={link} class="secondary-button"
      >View Service <Icon src={arrowRight} class="body-icon" /></a
    >
  </div>
</div>

<style lang="scss">
  @use "../styles/breakpoints" as *;

  .service-card {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    justify-content: space-between;
  }

  .featured {
    font-family: var(--font-accent);
    position: absolute;
    right: 0;
    top: -16px;
    padding: 4px 16px;
  }

  .card-body {
    padding-top: var(--card-padding-y);
    position: relative;
    border-top: 4px solid var(--dark-heading);
  }

  .card-footer {
    // padding-bottom: var(--card-padding-y);
    width: 100%;
  }

  .card-title {
    font-family: var(--font-heading);
    color: var(--dark-heading);
    font-size: var(--size-h3);
    margin-bottom: 0.5rem;
    font-weight: var(--weight-h3);
  }

  .desc {
    margin-bottom: 24px;
  }

  .card-thumbnail {
    max-width: 100%;
    border-radius: var(--standard-radius);
    overflow: hidden;
    aspect-ratio: 3/2;
  }

  .card-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media screen and (max-width: 880px) {
    .service-card {
      gap: 1rem;
    }
  }

  @media screen and (max-width: $breakpoint-sm) {
    .card-title {
      margin-bottom: 1rem;
    }
  }
</style>
